POSTGRES_USER=homeschool
POSTGRES_PASSWORD=changeme
POSTGRES_DB=homeschool
DATABASE_URL=postgresql+psycopg://homeschool:changeme@postgres:5432/homeschool

APP_PORT=8080
ATTACHMENTS_DIR=/data/attachments

# Image docker-compose.yml pulls when you run `docker compose up -d` without --build.
# Pin a specific release (e.g. ghcr.io/darkiris4/kayledex:v1.2.0) instead of latest if
# you want upgrades to be a deliberate step rather than automatic.
APP_IMAGE=ghcr.io/darkiris4/kayledex:latest

# "Today" for the dashboard and daily logging is computed in this timezone — set it to
# where the family actually lives, not where the server happens to run.
TZ=UTC
